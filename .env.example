# 복사해서 .env 로 사용 (.env 는 커밋하지 않음)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=delivery
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=pipeline

# Airflow (docker compose --profile airflow)
# 로컬 전용 값. 외부에 노출하는 환경이면 반드시 바꾼다
AIRFLOW_JWT_SECRET=local-dev-only
# Spark 가 읽을 착지 파일 (Spark 가 직접 glob 을 푼다)
SEARCH_LANDING_PATH=data/landing/search/*.jsonl
# 작업이 최종 실패하면 이 Slack 호환 웹훅으로 알린다. 비우면 data/alerts/failures.jsonl 에만 기록
ALERT_WEBHOOK_URL=
